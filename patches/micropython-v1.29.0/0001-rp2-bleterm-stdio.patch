From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alikhanyessaly <alikhan.yessaly@quantum.edu.kz>
Date: Tue, 17 Nov 2026 08:30:56 +0500
Subject: [PATCH 1/8] rp2: bleterm stdio

Call bleterm_tx_strn() from mp_hal_stdout_tx_strn, report BLE writability
in mp_hal_stdio_poll and release pending NUS writes when stdin is consumed.
Compiled only with MICROPY_PY_BLETERM (board PICOW_BLE).
---
 ports/rp2/mphalport.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/ports/rp2/mphalport.c b/ports/rp2/mphalport.c
index 32a1a645d..d56ec1906 100644
--- a/ports/rp2/mphalport.c
+++ b/ports/rp2/mphalport.c
@@ -45,6 +45,14 @@
 #include "lib/cyw43-driver/src/cyw43.h"
 #endif
 
+#ifndef MICROPY_PY_BLETERM
+#define MICROPY_PY_BLETERM (0)
+#endif
+#if MICROPY_PY_BLETERM
+// BLE terminal (board PICOW_BLE): static C module, see firmware/modules/bleterm.
+#include "bleterm.h"
+#endif
+
 #if PICO_RP2040
 // This needs to be added to the result of time_us_64() to get the number of
 // microseconds since the Epoch.
@@ -75,6 +83,9 @@ uintptr_t mp_hal_stdio_poll(uintptr_t poll_flags) {
     #if MICROPY_PY_OS_DUPTERM
     ret |= mp_os_dupterm_poll(poll_flags);
     #endif
+    #if MICROPY_PY_BLETERM
+    ret |= bleterm_stdio_poll(poll_flags);
+    #endif
     return ret;
 }
 
@@ -87,6 +98,10 @@ int mp_hal_stdin_rx_chr(void) {
         #if MICROPY_HW_USB_CDC || MICROPY_HW_ENABLE_UART_REPL || MICROPY_PY_OS_DUPTERM_NOTIFY
         int c = ringbuf_get(&stdin_ringbuf);
         if (c != -1) {
+            #if MICROPY_PY_BLETERM
+            // A BLE write may be waiting for room in the ring.
+            bleterm_stdin_consumed();
+            #endif
             return c;
         }
         #endif
@@ -117,6 +132,12 @@ mp_uint_t mp_hal_stdout_tx_strn(const char *str, mp_uint_t len) {
     }
     #endif
 
+    #if MICROPY_PY_BLETERM
+    // Never fails and never changes the return value: with no BLE client the
+    // bytes are discarded, exactly as if the terminal did not exist.
+    bleterm_tx_strn(str, len);
+    #endif
+
     #if MICROPY_PY_OS_DUPTERM
     int dupterm_res = mp_os_dupterm_tx_strn(str, len);
     if (dupterm_res >= 0) {
