+int mp_bluetooth_deinit(void) {
+    DEBUG_printf("mp_bluetooth_deinit\n");
+
+    // Nothing to do if not initialised.
+    if (!MP_STATE_PORT(bluetooth_btstack_root_pointers)) {
+        return 0;
+    }
