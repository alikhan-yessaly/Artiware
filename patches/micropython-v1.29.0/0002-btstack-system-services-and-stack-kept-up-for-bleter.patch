+// Drop pending user notify/indicate operations: they live on the GC heap and
+// are linked into att_server's per-connection request lists.
+static void btstack_notify_indicate_ready_handler(void *context);
+static void unlink_pending_ops(btstack_linked_list_t *list) {
+    btstack_linked_list_iterator_t it;
+    btstack_linked_list_iterator_init(&it, list);
+    while (btstack_linked_list_iterator_has_next(&it)) {
+        btstack_context_callback_registration_t *reg = (btstack_context_callback_registration_t *)btstack_linked_list_iterator_next(&it);
+        if (reg->callback == &btstack_notify_indicate_ready_handler) {
+            btstack_linked_list_iterator_remove(&it);
+        }
+    }
+}
+
+// Tear down user state only; the stack and bleterm's link stay.
+static void user_state_destroy(void) {
+    #if MICROPY_PY_BLUETOOTH_ENABLE_CENTRAL_MODE
+    gap_stop_scan();
+    gap_connect_cancel();
+    #endif
 
     #if MICROPY_PY_BLUETOOTH_ENABLE_GATT_CLIENT
-    // Remove our registration for notify/indicate.
     gatt_client_stop_listening_for_characteristic_value_updates(&MP_STATE_PORT(bluetooth_btstack_root_pointers)->notification);
+    #endif
+
+    btstack_linked_list_iterator_t it;
+    hci_connections_get_iterator(&it);
+    while (btstack_linked_list_iterator_has_next(&it)) {
+        hci_connection_t *conn = (hci_connection_t *)btstack_linked_list_iterator_next(&it);
+        unlink_pending_ops(&conn->att_server.notification_requests);
+        unlink_pending_ops(&conn->att_server.indication_requests);
+    }
+
+    // Advertising data pointer is about to dangle: bleterm re-sets its own.
+    MP_STATE_PORT(bluetooth_btstack_root_pointers) = NULL;
+    mp_bluetooth_btstack_reset_db();
+    bleterm_user_state_destroyed();
+}
+#endif
+
+// Full shutdown of the controller and BTstack (stock deinit).
+static int stack_down(void) {
+    if (MP_STATE_PORT(bluetooth_btstack_root_pointers) != NULL) {
+        mp_bluetooth_gap_advertise_stop();
+    } else if (mp_bluetooth_btstack_state == MP_BLUETOOTH_BTSTACK_STATE_ACTIVE) {
+        gap_advertisements_enable(false);
+    }
+
+    #if MICROPY_PY_BLUETOOTH_ENABLE_GATT_CLIENT
+    // Remove our registration for notify/indicate.
+    if (MP_STATE_PORT(bluetooth_btstack_root_pointers) != NULL) {
+        gatt_client_stop_listening_for_characteristic_value_updates(&MP_STATE_PORT(bluetooth_btstack_root_pointers)->notification);
+    }
     #endif // MICROPY_PY_BLUETOOTH_ENABLE_GATT_CLIENT
 
     // Set a timer that will forcibly set the state to TIMEOUT, which will stop the loop below.
@@ -742,8 +848,39 @@ int mp_bluetooth_deinit(void) {
     return timeout ? MP_ETIMEDOUT : 0;
 }
 
+#if MICROPY_PY_BLETERM
+int mp_bluetooth_btstack_stack_down(void) {
+    if (mp_bluetooth_btstack_state == MP_BLUETOOTH_BTSTACK_STATE_OFF) {
+        return 0;
+    }
